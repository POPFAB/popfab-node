{
  "name": "popfab",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the Popfab API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/client.test.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": ["popfab", "payments", "transfers", "fintech"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
