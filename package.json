{
  "name": "popfab",
  "version": "0.1.2",
  "description": "Official Node.js SDK for the Popfab API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/client.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test test-dist/sandbox.integration.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "release:check": "node scripts/release-check.mjs && npm run check && npm test && npm run test:integration && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "popfab",
    "payments",
    "transfers",
    "fintech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/POPFAB/popfab-node.git"
  },
  "bugs": {
    "url": "https://github.com/POPFAB/popfab-node/issues"
  },
  "homepage": "https://github.com/POPFAB/popfab-node#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
